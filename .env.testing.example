# Testing only. NEXT_PUBLIC values are intentionally public and are baked into
# the browser bundle during docker build. Replace with the Testing project's
# URL and publishable key locally; never add service_role/secret keys here.
NEXT_PUBLIC_SUPABASE_URL=https://your-testing-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_testing_placeholder
QR_ASISTENCIA_DOMAIN=testing.example.invalid
