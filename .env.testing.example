# Testing only. Copy to .env.testing outside version control and replace these
# placeholders locally. NEXT_PUBLIC values are public and baked into the image
# at build time; they must point to the dedicated Supabase Testing project.
NEXT_PUBLIC_SUPABASE_URL=https://your-testing-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_testing_placeholder
# Public HTTPS hostname served by Caddy. DNS must point to the Testing host.
QR_ASISTENCIA_DOMAIN=testing.example.invalid
# Canonical HTTPS origin used for Auth redirects and production Origin checks.
APP_BASE_URL=https://testing.example.invalid
# Optional, server-only; needed only if Testing will send Auth invitations.
# Store the real value in the host's secret manager, not in the image/build args.
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# INVITATION_FROM_EMAIL=Asistencia QR <noreply@example.invalid>
# Configure this exact HTTPS origin and the required /auth/confirm and
# /auth/callback URLs in Supabase Auth. Do not set NEXT_ALLOWED_DEV_ORIGIN here.
