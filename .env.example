NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server-only. Required only for Supabase Auth invitations; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Canonical HTTPS origin used for Auth invite callbacks (local development may use http://localhost:3000).
APP_BASE_URL=https://your-app.example.invalid
# Optional delivery path for invitations to Auth identities that already exist.
# The provider receives one-time Auth links only when an admin explicitly sends/resends an invitation.
RESEND_API_KEY=
INVITATION_FROM_EMAIL=Asistencia QR <noreply@example.invalid>
# Exact Cloudflare Tunnel hostname for local development (omit https://).
# Example: example-name.trycloudflare.com
NEXT_ALLOWED_DEV_ORIGIN=example-name.trycloudflare.com
