{
  "name": "asistencia-qr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run test:attendance && npm run test:reports && npm run test:scanner && npm run test:pin-lockout && npm run test:credentials && npm run test:employee-portal && npm run test:user-access && npm run test:auth-flow && npm run test:deployment",
    "test:attendance": "node --experimental-strip-types --test tests/attendance-presentation.test.mjs",
    "test:scanner": "node --test tests/scanner-context.test.mjs",
    "test:pin-lockout": "node --test tests/attendance-pin-lockout.test.mjs",
    "test:pin-lockout:db": "test -n \"${PIN_LOCKOUT_SUPABASE_WORKDIR:-}\" || { echo 'Set PIN_LOCKOUT_SUPABASE_WORKDIR to an isolated disposable Supabase project.' >&2; exit 2; }; grep -Eq '^project_id = \"qr_pin_lockout_disposable_[A-Za-z0-9_]+\"$' \"$PIN_LOCKOUT_SUPABASE_WORKDIR/supabase/config.toml\" || { echo 'Refusing DB tests: project_id is not marked disposable.' >&2; exit 2; }; npx supabase --workdir \"$PIN_LOCKOUT_SUPABASE_WORKDIR\" test db --local \"$PIN_LOCKOUT_SUPABASE_WORKDIR/supabase/tests/attendance_pin_lockout_test.sql\" && { test -n \"${PIN_LOCKOUT_DATABASE_URL:-}\" || { echo 'Set PIN_LOCKOUT_DATABASE_URL to the disposable database URL.' >&2; exit 2; }; node tests/attendance-pin-lockout-postgres.integration.mjs; }",
    "test:employee-portal": "node --experimental-strip-types --test tests/employee-portal-scope.test.mjs",
    "test:user-access": "node --experimental-strip-types --test tests/user-access-management.test.mjs tests/access-links.test.mjs",
    "test:deployment": "node --experimental-strip-types --test tests/deployment-readiness.test.mjs",
    "test:auth-flow": "node --experimental-strip-types --test tests/auth-email-flow.test.mjs",
    "test:credentials": "node --experimental-strip-types --test tests/employee-credential-emission.test.mjs tests/credential-api-error.test.mjs",
    "test:reports": "node --experimental-strip-types --test tests/reports-exports.test.mjs tests/reports-data.test.mjs tests/reports-export-lease.test.mjs",
    "test:reports:integration": "node --test tests/reports-cross-tenant.integration.test.mjs",
    "test:reports:lease:local": "node tests/reports-export-lease.local.integration.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:security:jwt": "node tests/security-jwt-matrix.integration.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@zxing/browser": "^0.2.1",
    "argon2": "^0.45.1",
    "exceljs": "4.4.0",
    "lucide-react": "^1.55.0",
    "next": "^16.4.0",
    "pdfkit": "0.17.2",
    "pg": "^8.23.1",
    "postcss": "^8.5.28",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "2.15.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "supabase": "2.120.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
